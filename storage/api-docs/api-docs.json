        "/v1/checkout/session": {
            "post": {
                "tags": [
                    "Checkout"
                ],
                "summary": "Create a checkout session",
                "operationId": "780e187ca52941adecce5d943a8782df",
                "parameters": [
                    {
                        "name": "Idempotency-Key",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "line_items",
                                    "customer",
                                    "shipping_address",
                                    "amount",
                                    "currency"
                                ],
                                "properties": {
                                    "line_items": {
                                        "type": "array",
                                        "items": {
                                            "type": "object"
                                        }
                                    },
                                    "customer": {
                                        "type": "object"
                                    },
                                    "shipping_address": {
                                        "type": "object"
                                    },
                                    "amount": {
                                        "type": "string"
                                    },
                                    "currency": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Session created"
                    },
                    "409": {
                        "description": "Duplicate idempotency key"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "AppKey": []
                    }
                ]
            }
        },
