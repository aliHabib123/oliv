        "/v1/pay": {
            "post": {
                "tags": [
                    "Payment"
                ],
                "summary": "Process payment with various payment providers",
                "operationId": "83fd19dea42d83ba003221521ebedb95",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "payment_type",
                                    "amount",
                                    "currency",
                                    "order_id",
                                    "customer",
                                    "items"
                                ],
                                "properties": {
                                    "payment_type": {
                                        "type": "string",
                                        "enum": [
                                            "tabby",
                                            "tamara",
                                            "stripe",
                                            "paypal"
                                        ]
                                    },
                                    "amount": {
                                        "type": "number",
                                        "format": "float"
                                    },
                                    "currency": {
                                        "type": "string",
                                        "maxLength": 3,
                                        "minLength": 3
                                    },
                                    "order_id": {
                                        "type": "string"
                                    },
                                    "customer": {
                                        "required": [
                                            "email",
                                            "phone"
                                        ],
                                        "properties": {
                                            "email": {
                                                "type": "string",
                                                "format": "email"
                                            },
                                            "phone": {
                                                "type": "string"
                                            }
                                        },
                                        "type": "object"
                                    },
                                    "items": {
                                        "type": "array",
                                        "items": {
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Payment processed successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "payment_type": {
                                            "type": "string"
                                        },
                                        "redirect_url": {
                                            "type": "string",
                                            "nullable": true
                                        },
                                        "session_id": {
                                            "type": "string",
                                            "nullable": true
                                        },
                                        "client_secret": {
                                            "type": "string",
                                            "nullable": true
                                        },
                                        "order_id": {
                                            "type": "string",
                                            "nullable": true
                                        },
                                        "currency": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Tenant not found"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "XAppKey": []
                    }
                ]
            }
        },
